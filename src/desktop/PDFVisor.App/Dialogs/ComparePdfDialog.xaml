<Window x:Class="PDFVisor.App.Dialogs.ComparePdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparar documentos PDF"
        Width="1240" Height="780"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <!-- Top Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtSummary" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkOnlyChanges"
                          Content="Solo páginas con cambios"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="ChkFilter_Changed"
                          Unchecked="ChkFilter_Changed"/>
                <CheckBox x:Name="ChkVisualDiff"
                          Content="Diff visual por píxeles"
                          VerticalAlignment="Center"
                          Checked="ChkVisualDiff_Changed"
                          Unchecked="ChkVisualDiff_Changed"
                          ToolTip="Superpone en magenta/rojo cualquier diferencia gráfica, firma o escaneo entre A y B"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="−" Style="{StaticResource SecondaryButton}" Width="28" Padding="0,3" Click="BtnZoomOut_Click" ToolTip="Alejar"/>
                <TextBlock x:Name="TxtZoom" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                <Button Content="+" Style="{StaticResource SecondaryButton}" Width="28" Padding="0,3" Margin="0,0,12,0" Click="BtnZoomIn_Click" ToolTip="Acercar"/>

                <Button Content="◀ Anterior" Style="{StaticResource SecondaryButton}" Click="BtnPrev_Click" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtPageLabel" Text="Página 1" VerticalAlignment="Center" Margin="6,0" FontWeight="Medium"/>
                <Button Content="Siguiente ▶" Style="{StaticResource SecondaryButton}" Click="BtnNext_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Bottom Diff Details -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#28888888" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Height="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtDiffDetails" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Side-by-side Page Comparison -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Page Diff List -->
            <Border Grid.Column="0" BorderBrush="#28888888" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="DiffList" BorderThickness="0" Background="Transparent" SelectionChanged="DiffList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4,3" FontSize="12"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Left Document Image -->
            <Border Grid.Column="2" BorderBrush="#28888888" BorderThickness="1" CornerRadius="6" Background="#2A2C30" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtLeftName" Foreground="White" Opacity="0.85" FontSize="12" Margin="0,0,0,6"/>
                    <ScrollViewer x:Name="ScrollLeft" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollLeft_ScrollChanged">
                        <Image x:Name="ImgLeft" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Document Image (or Visual Pixel Diff) -->
            <Border Grid.Column="4" BorderBrush="#28888888" BorderThickness="1" CornerRadius="6" Background="#2A2C30" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtRightName" Foreground="White" Opacity="0.85" FontSize="12" Margin="0,0,0,6"/>
                    <ScrollViewer x:Name="ScrollRight" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollRight_ScrollChanged">
                        <Image x:Name="ImgRight" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
