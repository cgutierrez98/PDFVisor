<Window x:Class="PDFVisor.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtPrompt"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="TxtValue"
                 Padding="8,6"
                 Margin="0,0,0,16"/>

        <PasswordBox x:Name="PwdValue"
                     Padding="8,6"
                     Margin="0,0,0,16"
                     Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar"
                    IsDefault="True"
                    Click="BtnOk_Click"
                    Padding="18,6"
                    Margin="0,0,8,0"/>
            <Button Content="Cancelar"
                    IsCancel="True"
                    Padding="18,6"/>
        </StackPanel>
    </StackPanel>
</Window>
