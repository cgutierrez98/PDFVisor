<Window x:Class="PDFVisor.App.Dialogs.SplitPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dividir documento PDF"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtHeader" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <RadioButton x:Name="RbRanges" Content="Por rangos (ej. 1-3, 4-6, 8)" IsChecked="True" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtRanges" Text="1-1" Padding="8,5" Margin="20,0,0,12"/>

        <RadioButton x:Name="RbEveryN" Content="Cada N páginas" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,12">
            <TextBox x:Name="TxtEveryN" Text="1" Width="64" Padding="6,4" TextAlignment="Center"/>
            <TextBlock Text="páginas por archivo (1 = un PDF por cada página)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" FontSize="12"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Dividir y elegir carpeta..."
                    IsDefault="True"
                    Click="BtnSplit_Click"
                    Style="{StaticResource PrimaryAccentButton}"
                    Padding="16,6" FontSize="13" Margin="0,0,8,0"/>
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
