<Window x:Class="PDFVisor.App.Dialogs.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marca de agua y numeración"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <CheckBox x:Name="ChkWatermark" Content="Añadir marca de agua diagonal a todas las páginas" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Margin="20,0,0,14">
            <TextBlock Text="Texto de la marca de agua:" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtWatermark" Text="CONFIDENCIAL" Padding="8,5" Margin="0,0,0,8"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Opacidad:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtOpacityPct" Text="22%" FontSize="12" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                <Slider x:Name="SldOpacity" Minimum="10" Maximum="180" Value="55" ValueChanged="SldOpacity_ValueChanged"/>
            </DockPanel>
        </StackPanel>

        <CheckBox x:Name="ChkPageNumbers" Content="Añadir numeración en el pie de página" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Margin="20,0,0,16">
            <TextBlock Text="Formato ({page} = página actual, {total} = total):" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPageNumFormat" Text="Página {page} de {total}" Padding="8,5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aplicar"
                    IsDefault="True"
                    Click="BtnApply_Click"
                    Style="{StaticResource PrimaryAccentButton}"
                    Padding="18,6" FontSize="13" Margin="0,0,8,0"/>
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
