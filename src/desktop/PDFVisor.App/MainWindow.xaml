<Window x:Class="PDFVisor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:PDFVisor.Viewport;assembly=PDFVisor.Viewport"
        Title="PDFVisor"
        Icon="Assets/PDFVisor.ico"
        Height="880" Width="1400"
        MinHeight="560" MinWidth="920"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">

        <!-- 1. Classic Native Menu Bar -->
        <Menu DockPanel.Dock="Top" Padding="6,2">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir..." InputGestureText="Ctrl+O" Click="BtnOpen_Click"/>
                <MenuItem x:Name="MenuSave" Header="_Guardar" InputGestureText="Ctrl+S" Click="BtnSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Guardar _como..." InputGestureText="Ctrl+Shift+S" Click="BtnSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuOptimize" Header="_Optimizar tamaño y carga rápida..." Click="BtnOptimize_Click"/>
                <MenuItem x:Name="MenuPrint" Header="_Imprimir..." InputGestureText="Ctrl+P" Click="BtnPrint_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCloseTab" Header="Cerrar _pestaña" InputGestureText="Ctrl+W" Click="MenuCloseTab_Click"/>
                <MenuItem Header="_Salir" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="_Editar">
                <MenuItem x:Name="MenuUndo" Header="_Deshacer" InputGestureText="Ctrl+Z" Click="BtnUndo_Click"/>
                <MenuItem x:Name="MenuRedo" Header="_Rehacer" InputGestureText="Ctrl+Y" Click="BtnRedo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCopy" Header="_Copiar texto seleccionado" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem x:Name="MenuFind" Header="_Buscar..." InputGestureText="Ctrl+F" Click="BtnToggleSearch_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuInsertImage" Header="Insertar _imagen..." Click="BtnInsertImage_Click"/>
                <MenuItem x:Name="MenuAddTextField" Header="Añadir _campo de formulario..." Click="BtnAddTextField_Click"/>
            </MenuItem>

            <MenuItem Header="_Ver">
                <MenuItem x:Name="MenuZoomIn" Header="_Acercar" InputGestureText="Ctrl++" Click="BtnZoomIn_Click"/>
                <MenuItem x:Name="MenuZoomOut" Header="_Alejar" InputGestureText="Ctrl+-" Click="BtnZoomOut_Click"/>
                <MenuItem x:Name="MenuResetZoom" Header="Tamaño _real (100%)" InputGestureText="Ctrl+0" Click="BtnResetZoom_Click"/>
                <MenuItem x:Name="MenuFitWidth" Header="Ajustar al _ancho" Click="BtnFitWidth_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuDarkRead" Header="Modo _lectura oscuro" IsCheckable="True" Click="MenuDarkRead_Click"/>
            </MenuItem>

            <MenuItem Header="_Páginas">
                <MenuItem x:Name="MenuRotatePage" Header="_Rotar 90° a la derecha" Click="BtnRotatePage_Click"/>
                <MenuItem x:Name="MenuMoveUp" Header="Mover página _arriba" Click="BtnMoveUp_Click"/>
                <MenuItem x:Name="MenuMoveDown" Header="Mover página a_bajo" Click="BtnMoveDown_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuMergePdf" Header="_Unir con otro PDF..." Click="BtnMergePdf_Click"/>
                <MenuItem x:Name="MenuExtractPage" Header="_Extraer página actual..." Click="BtnExtractPage_Click"/>
                <MenuItem x:Name="MenuDeletePage" Header="E_liminar página actual" Click="BtnDeletePage_Click"/>
            </MenuItem>

            <MenuItem Header="_Herramientas">
                <MenuItem x:Name="MenuOcrPage" Header="Reconocer texto (_OCR) en página actual" Click="BtnOcrPage_Click"/>
                <MenuItem x:Name="MenuOcrAll" Header="Reconocer texto (OCR) en _todo el documento" Click="BtnOcrAll_Click"/>
            </MenuItem>

            <MenuItem Header="_Seguridad">
                <MenuItem x:Name="MenuSignPades" Header="_Firmar digitalmente..." Click="BtnSignPades_Click"/>
                <MenuItem x:Name="MenuEncrypt" Header="_Proteger con contraseña..." Click="BtnEncrypt_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSanitize" Header="_Sanear metadatos e historial..." Click="BtnSanitize_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Clean Single-Row Fluent Icon Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="#22888888" BorderThickness="0,1,0,1" Padding="10,4">
            <DockPanel LastChildFill="False">
                <!-- Left: File, History, Navigation, Zoom -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpen" Style="{StaticResource IconToolbarButton}" Content="&#xE8E5;" Click="BtnOpen_Click" ToolTip="Abrir PDF (Ctrl+O)"/>
                    <Button x:Name="BtnSave" Style="{StaticResource IconToolbarButton}" Content="&#xE74E;" Click="BtnSave_Click" ToolTip="Guardar (Ctrl+S)"/>
                    <Button x:Name="BtnPrint" Style="{StaticResource IconToolbarButton}" Content="&#xE749;" Click="BtnPrint_Click" ToolTip="Imprimir (Ctrl+P)"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource IconToolbarButton}" Content="&#xE7A7;" Click="BtnUndo_Click" ToolTip="Deshacer (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconToolbarButton}" Content="&#xE7A6;" Click="BtnRedo_Click" ToolTip="Rehacer (Ctrl+Y)"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnPrev" Style="{StaticResource IconToolbarButton}" Content="&#xE76B;" Click="BtnPrev_Click" ToolTip="Página anterior"/>
                    <TextBox x:Name="TxtPageJump"
                             Width="42"
                             Height="26"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="2,0"
                             KeyDown="TxtPageJump_KeyDown"
                             LostFocus="TxtPageJump_LostFocus"
                             ToolTip="Ir a página (Enter)"/>
                    <TextBlock x:Name="TxtPageTotal" Text="/ 0" VerticalAlignment="Center" Margin="5,0,4,0" Opacity="0.75" FontSize="12"/>
                    <Button x:Name="BtnNext" Style="{StaticResource IconToolbarButton}" Content="&#xE76C;" Click="BtnNext_Click" ToolTip="Página siguiente"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnZoomOut" Style="{StaticResource IconToolbarButton}" Content="&#xE71F;" Click="BtnZoomOut_Click" ToolTip="Alejar (Ctrl+-)"/>
                    <ComboBox x:Name="CmbZoom"
                              Width="88"
                              Height="26"
                              Margin="2,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbZoom_SelectionChanged"
                              ToolTip="Nivel de zoom">
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                        <ComboBoxItem Content="Ajustar"/>
                    </ComboBox>
                    <Button x:Name="BtnZoomIn" Style="{StaticResource IconToolbarButton}" Content="&#xE8A3;" Click="BtnZoomIn_Click" ToolTip="Acercar (Ctrl++)"/>
                    <Button x:Name="BtnRotatePage" Style="{StaticResource IconToolbarButton}" Content="&#xE7AD;" Click="BtnRotatePage_Click" ToolTip="Rotar página 90°"/>
                </StackPanel>

                <!-- Right: Tools & View Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolToggleButton}" Content="&#xE7C9;" IsChecked="True" Click="ToolButton_Click" ToolTip="Seleccionar texto"/>
                    <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolToggleButton}" Content="&#xE7E6;" Click="ToolButton_Click" ToolTip="Resaltar"/>
                    <ToggleButton x:Name="ToolSquare" Style="{StaticResource ToolToggleButton}" Content="&#xE739;" Click="ToolButton_Click" ToolTip="Dibujar rectángulo"/>
                    <ToggleButton x:Name="ToolNote" Style="{StaticResource ToolToggleButton}" Content="&#xE70B;" Click="ToolButton_Click" ToolTip="Añadir nota adhesiva"/>
                    <ToggleButton x:Name="ToolInk" Style="{StaticResource ToolToggleButton}" Content="&#xE76D;" Click="ToolButton_Click" ToolTip="Dibujo a mano alzada"/>
                    <ToggleButton x:Name="ToolAddText" Style="{StaticResource ToolToggleButton}" Content="&#xE8D2;" Click="ToolButton_Click" ToolTip="Insertar texto"/>
                    <ToggleButton x:Name="ToolRedact" Style="{StaticResource ToolToggleButton}" Content="&#xE72E;" Click="ToolButton_Click" ToolTip="Censurar permanentemente"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <ToggleButton x:Name="BtnDarkRead" Style="{StaticResource ToolToggleButton}" Content="&#xE708;" Click="BtnDarkRead_Click" ToolTip="Modo lectura oscuro"/>
                    <Button x:Name="BtnSearchToggle" Style="{StaticResource IconToolbarButton}" Content="&#xE721;" Click="BtnToggleSearch_Click" ToolTip="Buscar en el documento (Ctrl+F)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Modern Document Tab Strip -->
        <Border x:Name="TabStripBorder" DockPanel.Dock="Top" BorderBrush="#22888888" BorderThickness="0,0,0,1" Padding="6,3,6,2" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconToolbarButton}"
                        Content="&#xE710;"
                        Width="26" Height="26" FontSize="12"
                        Click="BtnOpen_Click"
                        ToolTip="Abrir otro PDF (Ctrl+O)"/>
                <ListBox x:Name="DocumentTabs"
                         SelectionChanged="DocumentTabs_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,2">
                                <TextBlock FontFamily="{StaticResource FluentIconsFont}" Text="&#xEA90;" FontSize="12" Foreground="#D92638" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DisplayTabTitle}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                                <Button Content="&#xE711;"
                                        FontFamily="{StaticResource FluentIconsFont}"
                                        Tag="{Binding}"
                                        Click="BtnCloseTab_Click"
                                        Margin="8,0,0,0"
                                        Width="18" Height="18"
                                        FontSize="9"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        ToolTip="Cerrar pestaña (Ctrl+W)"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 4. Clean, Minimal Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="10,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="Listo" FontSize="12" Opacity="0.82"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusPageSize" Text="" FontSize="12" Opacity="0.72" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusZoom" Text="" FontSize="12" Opacity="0.72"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 5. Main Content Area -->
        <Grid>
            <!-- 5A. Document Workspace (visible when a PDF is open) -->
            <Grid x:Name="WorkspaceContainer" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition x:Name="SidePanelColumn" Width="240"/>
                    <ColumnDefinition x:Name="SideSplitterColumn" Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Activity Rail (Acrobat / VS Code style) -->
                <Border Grid.Column="0" BorderBrush="#22888888" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                        <ToggleButton x:Name="RailThumbnails" Style="{StaticResource RailIconButton}" Content="&#xE80A;" IsChecked="True" Click="RailButton_Click" ToolTip="Miniaturas de páginas"/>
                        <ToggleButton x:Name="RailBookmarks" Style="{StaticResource RailIconButton}" Content="&#xE8A4;" Click="RailButton_Click" ToolTip="Marcadores / Índice"/>
                        <ToggleButton x:Name="RailForms" Style="{StaticResource RailIconButton}" Content="&#xE8F1;" Click="RailButton_Click" ToolTip="Campos de formulario"/>
                        <ToggleButton x:Name="RailSignatures" Style="{StaticResource RailIconButton}" Content="&#xE8D7;" Click="RailButton_Click" ToolTip="Firmas digitales"/>
                        <ToggleButton x:Name="RailObjects" Style="{StaticResource RailIconButton}" Content="&#xE81E;" Click="RailButton_Click" ToolTip="Objetos de la página"/>
                    </StackPanel>
                </Border>

                <!-- Collapsible Left Side Panel -->
                <Border x:Name="SidePanelBorder" Grid.Column="1" BorderBrush="#22888888" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,10,8,8">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconToolbarButton}"
                                    Content="&#xE711;" Width="24" Height="24" FontSize="10"
                                    Click="BtnCollapseSidebar_Click"
                                    ToolTip="Ocultar panel"/>
                            <TextBlock x:Name="TxtSidePanelTitle" Text="Miniaturas" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <!-- Panel 0: Thumbnails -->
                            <ListBox x:Name="PageList"
                                     SelectionChanged="PageList_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,6" HorizontalAlignment="Center">
                                            <Border Background="White"
                                                    BorderBrush="#33888888"
                                                    BorderThickness="1"
                                                    Width="148"
                                                    MinHeight="168"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Panel 1: Bookmarks -->
                            <ListBox x:Name="BookmarkList"
                                     Visibility="Collapsed"
                                     SelectionChanged="BookmarkList_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayIndent}" TextTrimming="CharacterEllipsis" Margin="4,4" FontSize="12.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Panel 2: Forms -->
                            <DockPanel x:Name="FormsPanel" Visibility="Collapsed">
                                <Button DockPanel.Dock="Top"
                                        Content="Añadir campo de texto"
                                        Click="BtnAddTextField_Click"
                                        Margin="10,2,10,8"
                                        Padding="10,5"/>
                                <ListBox x:Name="FormFieldList"
                                         MouseDoubleClick="FormFieldList_MouseDoubleClick"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Value}" Opacity="0.75" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 3: Signatures -->
                            <DockPanel x:Name="SignaturesPanel" Visibility="Collapsed">
                                <Button DockPanel.Dock="Top"
                                        Content="Firmar documento..."
                                        Click="BtnSignPades_Click"
                                        Margin="10,2,10,8"
                                        Padding="10,5"/>
                                <ListBox x:Name="SignatureList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#33888888" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SignerName}" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" Opacity="0.85"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 4: Page Objects -->
                            <ListBox x:Name="PageObjectList"
                                     Visibility="Collapsed"
                                     MouseDoubleClick="PageObjectList_MouseDoubleClick"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="6"
                                     ToolTip="Doble clic en un texto para editarlo">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" Margin="4,4" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="SideSplitter" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- Center Viewport + Floating Search Overlay -->
                <Grid Grid.Column="3">
                    <viewport:PdfPageViewport x:Name="PdfViewport"/>

                    <!-- Floating Chrome/Edge-style Find Bar (Ctrl+F) -->
                    <Border x:Name="FloatingSearchBar"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,22,0"
                            Padding="10,6"
                            CornerRadius="6"
                            BorderBrush="#44888888"
                            BorderThickness="1"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.32" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearch"
                                     Width="210"
                                     Height="26"
                                     Padding="6,2"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtSearch_KeyDown"/>
                            <TextBlock x:Name="TxtSearchStatus"
                                       Text=""
                                       MinWidth="56"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Opacity="0.75"
                                       Margin="6,0"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE70E;" Width="26" Height="26" FontSize="11" Click="BtnSearchPrev_Click" ToolTip="Coincidencia anterior (Shift+Enter)"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE70D;" Width="26" Height="26" FontSize="11" Click="BtnSearchNext_Click" ToolTip="Coincidencia siguiente (Enter)"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10" Click="BtnCloseSearch_Click" ToolTip="Cerrar (Esc)"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 5B. Welcome / Empty State Screen (visible when no document is open) -->
            <Grid x:Name="WelcomeContainer" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <Image Source="Assets/PDFVisor.png" Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="PDFVisor" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Abre un documento o arrastra archivos PDF aquí para empezar"
                               FontSize="13.5" Opacity="0.72" HorizontalAlignment="Center" Margin="0,6,0,22"/>

                    <Button Content="Abrir documento PDF"
                            Style="{StaticResource PrimaryAccentButton}"
                            HorizontalAlignment="Center"
                            Click="BtnOpen_Click"/>

                    <!-- Recent Documents Card -->
                    <StackPanel x:Name="RecentFilesSection" Margin="0,32,0,0" Visibility="Collapsed">
                        <DockPanel Margin="2,0,2,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Limpiar"
                                    Click="BtnClearRecent_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Opacity="0.65"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <TextBlock Text="Documentos recientes" FontSize="13" FontWeight="SemiBold" Opacity="0.85"/>
                        </DockPanel>
                        <Border BorderBrush="#28888888" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ListBox x:Name="RecentFilesList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="220"
                                     MouseDoubleClick="RecentFilesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5" Cursor="Hand">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13"/>
                                            <TextBlock Text="{Binding DirectoryDisplay}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
