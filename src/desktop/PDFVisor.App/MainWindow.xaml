<Window x:Class="PDFVisor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:PDFVisor.Viewport;assembly=PDFVisor.Viewport"
        Title="PDFVisor"
        Icon="Assets/PDFVisor.ico"
        Height="880" Width="1400"
        MinHeight="560" MinWidth="920"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid>
    <DockPanel LastChildFill="True">

        <!-- 1. Classic Native Menu Bar -->
        <Menu x:Name="MainMenuBar" DockPanel.Dock="Top" Padding="6,2">
            <MenuItem x:Name="MenuRootFile" Header="_Archivo">
                <MenuItem x:Name="MenuOpen" Header="_Abrir..." InputGestureText="Ctrl+O" Click="BtnOpen_Click"/>
                <MenuItem Header="Crear PDF desde _imágenes..." Click="MenuCreateFromImages_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSave" Header="_Guardar" InputGestureText="Ctrl+S" Click="BtnSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Guardar _como..." InputGestureText="Ctrl+Shift+S" Click="BtnSaveAs_Click"/>
                <MenuItem x:Name="MenuExportImage" Header="_Exportar página como imagen..." Click="MenuExportImage_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuProperties" Header="Propiedades y _metadatos..." InputGestureText="Ctrl+D" Click="MenuProperties_Click"/>
                <MenuItem x:Name="MenuOptimize" Header="_Optimizar tamaño y carga rápida..." Click="BtnOptimize_Click"/>
                <MenuItem x:Name="MenuPrint" Header="_Imprimir..." InputGestureText="Ctrl+P" Click="BtnPrint_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuRestoreTabs" Header="_Restaurar pestañas al iniciar" IsCheckable="True" Click="MenuRestoreTabs_Click"/>
                <MenuItem x:Name="MenuCloseTab" Header="Cerrar _pestaña" InputGestureText="Ctrl+W" Click="MenuCloseTab_Click"/>
                <MenuItem x:Name="MenuExit" Header="_Salir" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRootEdit" Header="_Editar">
                <MenuItem x:Name="MenuUndo" Header="_Deshacer" InputGestureText="Ctrl+Z" Click="BtnUndo_Click"/>
                <MenuItem x:Name="MenuRedo" Header="_Rehacer" InputGestureText="Ctrl+Y" Click="BtnRedo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCopy" Header="_Copiar texto seleccionado" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem x:Name="MenuFind" Header="_Buscar..." InputGestureText="Ctrl+F" Click="BtnToggleSearch_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuInsertImage" Header="Insertar _imagen..." Click="BtnInsertImage_Click"/>
                <MenuItem x:Name="MenuAddTextField" Header="Añadir campo de _texto..." Click="BtnAddTextField_Click"/>
                <MenuItem x:Name="MenuAddCheckboxField" Header="Añadir _casilla de verificación..." Click="BtnAddCheckboxField_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRootView" Header="_Ver">
                <MenuItem x:Name="MenuNavBack" Header="Ir _atrás" InputGestureText="Alt+Izq" Click="BtnNavBack_Click"/>
                <MenuItem x:Name="MenuNavForward" Header="Ir a_delante" InputGestureText="Alt+Der" Click="BtnNavForward_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuZoomIn" Header="_Acercar" InputGestureText="Ctrl++" Click="BtnZoomIn_Click"/>
                <MenuItem x:Name="MenuZoomOut" Header="_Alejar" InputGestureText="Ctrl+-" Click="BtnZoomOut_Click"/>
                <MenuItem x:Name="MenuResetZoom" Header="Tamaño _real (100%)" InputGestureText="Ctrl+0" Click="BtnResetZoom_Click"/>
                <MenuItem x:Name="MenuFitWidth" Header="Ajustar al _ancho" Click="BtnFitWidth_Click"/>
                <MenuItem x:Name="MenuFitPage" Header="Ajustar a la _página completa" Click="BtnFitPage_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTwoPage" Header="Vista a _doble página (Modo libro)" IsCheckable="True" Click="MenuTwoPage_Click"/>
                <MenuItem x:Name="MenuDarkRead" Header="Modo _lectura oscuro" IsCheckable="True" Click="MenuDarkRead_Click"/>
                <MenuItem x:Name="MenuFullscreen" Header="_Pantalla completa" InputGestureText="F11" IsCheckable="True" Click="MenuFullscreen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuRootLanguage" Header="_Idioma">
                    <MenuItem x:Name="MenuLangEs" Header="Español" Tag="es" IsCheckable="True" Click="MenuLang_Click"/>
                    <MenuItem x:Name="MenuLangEn" Header="English" Tag="en" IsCheckable="True" Click="MenuLang_Click"/>
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="MenuRootPages" Header="_Páginas">
                <MenuItem x:Name="MenuInsertBlankPage" Header="_Insertar página en blanco" Click="BtnInsertBlankPage_Click"/>
                <MenuItem x:Name="MenuCropPage" Header="Re_cortar márgenes de página..." Click="BtnCropPage_Click"/>
                <MenuItem x:Name="MenuRotatePage" Header="_Rotar 90° a la derecha" Click="BtnRotatePage_Click"/>
                <MenuItem x:Name="MenuMoveUp" Header="Mover página _arriba" Click="BtnMoveUp_Click"/>
                <MenuItem x:Name="MenuMoveDown" Header="Mover página a_bajo" Click="BtnMoveDown_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuMergePdf" Header="_Unir con otro PDF..." Click="BtnMergePdf_Click"/>
                <MenuItem x:Name="MenuSplitPdf" Header="_Dividir PDF..." Click="MenuSplitPdf_Click"/>
                <MenuItem x:Name="MenuExtractPage" Header="_Extraer página actual..." Click="BtnExtractPage_Click"/>
                <MenuItem x:Name="MenuDeletePage" Header="E_liminar página actual" Click="BtnDeletePage_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRootTools" Header="_Herramientas">
                <MenuItem x:Name="MenuWatermark" Header="_Marca de agua y numeración..." Click="MenuWatermark_Click"/>
                <MenuItem x:Name="MenuComparePdf" Header="_Comparar con otro PDF..." Click="MenuComparePdf_Click"/>
                <MenuItem x:Name="MenuFlattenPdf" Header="_Aplanar formularios y anotaciones" Click="BtnFlattenPdf_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuOcrPage" Header="Reconocer texto (_OCR) en página actual" Click="BtnOcrPage_Click"/>
                <MenuItem x:Name="MenuOcrAll" Header="Reconocer texto (OCR) en _todo el documento" Click="BtnOcrAll_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRootSecurity" Header="_Seguridad">
                <MenuItem x:Name="MenuSignPades" Header="_Firmar digitalmente..." Click="BtnSignPades_Click"/>
                <MenuItem x:Name="MenuEncrypt" Header="_Proteger con contraseña y permisos..." Click="BtnEncrypt_Click"/>
                <MenuItem x:Name="MenuDecrypt" Header="_Quitar contraseña y exportar..." Click="BtnDecrypt_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSanitize" Header="_Sanear metadatos e historial..." Click="BtnSanitize_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRootHelp" Header="A_yuda">
                <MenuItem Header="Buscar _actualizaciones..." Click="MenuCheckUpdates_Click"/>
                <MenuItem Header="_Informar de un problema..." Click="MenuReportIssue_Click"/>
                <MenuItem Header="Abrir carpeta de _logs" Click="MenuOpenLogs_Click"/>
                <Separator/>
                <MenuItem Header="_Acerca de PDFVisor" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Update Available InfoBar (non-intrusive banner, shown only when a newer GitHub Release exists) -->
        <Border x:Name="UpdateBanner"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="#22D92638"
                BorderBrush="#55D92638"
                BorderThickness="0,0,0,1"
                Padding="14,7">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource FluentIconsFont}" Text="&#xE896;" FontSize="15" Foreground="#F04455" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtUpdateBanner" Text="Nueva versión disponible" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDownloadUpdate"
                            Content="Actualizar ahora"
                            Style="{StaticResource PrimaryAccentButton}"
                            Padding="12,4"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Click="BtnDownloadUpdate_Click"/>
                    <Button Content="Ver notas"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,4"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Click="BtnOpenReleaseNotes_Click"/>
                    <Button Style="{StaticResource IconToolbarButton}"
                            Content="&#xE711;"
                            Width="24" Height="24" FontSize="10"
                            Click="BtnDismissUpdate_Click"
                            ToolTip="Ocultar aviso"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Clean Single-Row Fluent Icon Toolbar (shown when a document is open) -->
        <Border x:Name="ToolbarBorder" DockPanel.Dock="Top" BorderBrush="#22888888" BorderThickness="0,1,0,1" Padding="10,4" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <!-- Left: File, History, Back/Forward, Page Jump, Zoom -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpen" Style="{StaticResource IconToolbarButton}" Content="&#xE8E5;" Click="BtnOpen_Click" ToolTip="Abrir PDF (Ctrl+O)"/>
                    <Button x:Name="BtnSave" Style="{StaticResource IconToolbarButton}" Content="&#xE74E;" Click="BtnSave_Click" ToolTip="Guardar (Ctrl+S)"/>
                    <Button x:Name="BtnPrint" Style="{StaticResource IconToolbarButton}" Content="&#xE749;" Click="BtnPrint_Click" ToolTip="Imprimir (Ctrl+P)"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource IconToolbarButton}" Content="&#xE7A7;" Click="BtnUndo_Click" ToolTip="Deshacer (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconToolbarButton}" Content="&#xE7A6;" Click="BtnRedo_Click" ToolTip="Rehacer (Ctrl+Y)"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnNavBack" Style="{StaticResource IconToolbarButton}" Content="&#xE72B;" Click="BtnNavBack_Click" ToolTip="Volver a vista anterior (Alt+Izq)"/>
                    <Button x:Name="BtnNavForward" Style="{StaticResource IconToolbarButton}" Content="&#xE72A;" Click="BtnNavForward_Click" ToolTip="Avanzar vista (Alt+Der)"/>

                    <Button x:Name="BtnPrev" Style="{StaticResource IconToolbarButton}" Content="&#xE76B;" Click="BtnPrev_Click" ToolTip="Página anterior"/>
                    <TextBox x:Name="TxtPageJump"
                             Width="42"
                             Height="26"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="2,0"
                             KeyDown="TxtPageJump_KeyDown"
                             LostFocus="TxtPageJump_LostFocus"
                             ToolTip="Ir a página (Enter)"/>
                    <TextBlock x:Name="TxtPageTotal" Text="/ 0" VerticalAlignment="Center" Margin="5,0,4,0" Opacity="0.75" FontSize="12"/>
                    <Button x:Name="BtnNext" Style="{StaticResource IconToolbarButton}" Content="&#xE76C;" Click="BtnNext_Click" ToolTip="Página siguiente"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <Button x:Name="BtnZoomOut" Style="{StaticResource IconToolbarButton}" Content="&#xE71F;" Click="BtnZoomOut_Click" ToolTip="Alejar (Ctrl+-)"/>
                    <ComboBox x:Name="CmbZoom"
                              Width="92"
                              Height="26"
                              Margin="2,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbZoom_SelectionChanged"
                              ToolTip="Nivel de zoom">
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                        <ComboBoxItem Content="Ancho"/>
                        <ComboBoxItem Content="Página"/>
                    </ComboBox>
                    <Button x:Name="BtnZoomIn" Style="{StaticResource IconToolbarButton}" Content="&#xE8A3;" Click="BtnZoomIn_Click" ToolTip="Acercar (Ctrl++)"/>
                    <Button x:Name="BtnRotatePage" Style="{StaticResource IconToolbarButton}" Content="&#xE7AD;" Click="BtnRotatePage_Click" ToolTip="Rotar página 90°"/>
                </StackPanel>

                <!-- Right: Color/Font Options (when annotating), Segmented Tools Pill & View Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ToolOptionsBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                        <Button Tag="FFEA00FF" Click="ColorSwatch_Click" Width="18" Height="18" Margin="2,0" Cursor="Hand" ToolTip="Amarillo" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#FFEA00"/>
                        <Button Tag="43A047FF" Click="ColorSwatch_Click" Width="18" Height="18" Margin="2,0" Cursor="Hand" ToolTip="Verde" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#43A047"/>
                        <Button Tag="1E88E5FF" Click="ColorSwatch_Click" Width="18" Height="18" Margin="2,0" Cursor="Hand" ToolTip="Azul" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#1E88E5"/>
                        <Button Tag="E53935FF" Click="ColorSwatch_Click" Width="18" Height="18" Margin="2,0" Cursor="Hand" ToolTip="Rojo" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#E53935"/>
                        <Button Tag="181818FF" Click="ColorSwatch_Click" Width="18" Height="18" Margin="2,0" Cursor="Hand" ToolTip="Negro" BorderThickness="1" BorderBrush="#66FFFFFF" Background="#181818"/>
                        <ComboBox x:Name="CmbFontSize"
                                  Width="64"
                                  Height="26"
                                  Margin="6,0,0,0"
                                  SelectedIndex="2"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbFontSize_SelectionChanged"
                                  ToolTip="Tamaño de fuente">
                            <ComboBoxItem Content="10 pt"/>
                            <ComboBoxItem Content="12 pt"/>
                            <ComboBoxItem Content="14 pt"/>
                            <ComboBoxItem Content="18 pt"/>
                            <ComboBoxItem Content="24 pt"/>
                            <ComboBoxItem Content="32 pt"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="#10888888" BorderBrush="#22888888" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolToggleButton}" Content="&#xE7C9;" IsChecked="True" Click="ToolButton_Click" ToolTip="Seleccionar texto / objetos"/>
                            <ToggleButton x:Name="ToolHand" Style="{StaticResource ToolToggleButton}" Content="&#xE7C2;" Click="ToolButton_Click" ToolTip="Mano / desplazar página (o mantén Espacio)"/>
                            <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolToggleButton}" Content="&#xE7E6;" Click="ToolButton_Click" ToolTip="Resaltar texto"/>
                            <ToggleButton x:Name="ToolUnderline" Style="{StaticResource ToolToggleButton}" Content="&#xE8DC;" Click="ToolButton_Click" ToolTip="Subrayar texto"/>
                            <ToggleButton x:Name="ToolStrikeOut" Style="{StaticResource ToolToggleButton}" Content="&#xEDE0;" Click="ToolButton_Click" ToolTip="Tachar texto"/>
                            <ToggleButton x:Name="ToolSquare" Style="{StaticResource ToolToggleButton}" Content="&#xE739;" Click="ToolButton_Click" ToolTip="Dibujar rectángulo"/>
                            <ToggleButton x:Name="ToolNote" Style="{StaticResource ToolToggleButton}" Content="&#xE70B;" Click="ToolButton_Click" ToolTip="Añadir nota adhesiva"/>
                            <ToggleButton x:Name="ToolInk" Style="{StaticResource ToolToggleButton}" Content="&#xE76D;" Click="ToolButton_Click" ToolTip="Dibujo a mano alzada"/>
                            <ToggleButton x:Name="ToolAddText" Style="{StaticResource ToolToggleButton}" Content="&#xE8D2;" Click="ToolButton_Click" ToolTip="Insertar texto"/>
                            <ToggleButton x:Name="ToolRedact" Style="{StaticResource ToolToggleButton}" Content="&#xE72E;" Click="ToolButton_Click" ToolTip="Censurar permanentemente"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <ToggleButton x:Name="BtnDarkRead" Style="{StaticResource ToolToggleButton}" Content="&#xE708;" Click="BtnDarkRead_Click" ToolTip="Modo lectura oscuro"/>
                    <Button x:Name="BtnSearchToggle" Style="{StaticResource IconToolbarButton}" Content="&#xE721;" Click="BtnToggleSearch_Click" ToolTip="Buscar en el documento (Ctrl+F)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Modern Document Tab Strip (middle-click close & drag-to-reorder) -->
        <Border x:Name="TabStripBorder" DockPanel.Dock="Top" BorderBrush="#22888888" BorderThickness="0,0,0,1" Padding="6,3,6,2" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconToolbarButton}"
                        Content="&#xE710;"
                        Width="26" Height="26" FontSize="12"
                        Click="BtnOpen_Click"
                        ToolTip="Abrir otro PDF (Ctrl+O)"/>
                <ListBox x:Name="DocumentTabs"
                         AllowDrop="True"
                         PreviewMouseDown="DocumentTabs_PreviewMouseDown"
                         PreviewMouseMove="DocumentTabs_PreviewMouseMove"
                         Drop="DocumentTabs_Drop"
                         SelectionChanged="DocumentTabs_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,2">
                                <TextBlock FontFamily="{StaticResource FluentIconsFont}" Text="&#xEA90;" FontSize="12" Foreground="#D92638" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DisplayTabTitle}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                                <Button Content="&#xE711;"
                                        FontFamily="{StaticResource FluentIconsFont}"
                                        Tag="{Binding}"
                                        Click="BtnCloseTab_Click"
                                        Margin="8,0,0,0"
                                        Width="18" Height="18"
                                        FontSize="9"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        ToolTip="Cerrar pestaña (Ctrl+W / Clic central)"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 4. Clean, Minimal Status Bar -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Padding="10,2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="StatusProgressBar"
                                 Width="84" Height="4"
                                 IsIndeterminate="True"
                                 Foreground="#D92638"
                                 Margin="0,0,10,0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusMessage" Text="Listo" FontSize="12" Opacity="0.82"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusPageSize" Text="" FontSize="12" Opacity="0.72" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusZoom" Text="" FontSize="12" Opacity="0.72"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 5. Main Content Area -->
        <Grid>
            <!-- 5A. Document Workspace (visible when a PDF is open) -->
            <Grid x:Name="WorkspaceContainer" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition x:Name="SidePanelColumn" Width="250"/>
                    <ColumnDefinition x:Name="SideSplitterColumn" Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Activity Rail -->
                <Border Grid.Column="0" BorderBrush="#22888888" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                        <ToggleButton x:Name="RailThumbnails" Style="{StaticResource RailIconButton}" Content="&#xE80A;" IsChecked="True" Click="RailButton_Click" ToolTip="Miniaturas de páginas"/>
                        <ToggleButton x:Name="RailBookmarks" Style="{StaticResource RailIconButton}" Content="&#xE8A4;" Click="RailButton_Click" ToolTip="Marcadores / Índice"/>
                        <ToggleButton x:Name="RailComments" Style="{StaticResource RailIconButton}" Content="&#xE90A;" Click="RailButton_Click" ToolTip="Comentarios y anotaciones"/>
                        <ToggleButton x:Name="RailForms" Style="{StaticResource RailIconButton}" Content="&#xE8F1;" Click="RailButton_Click" ToolTip="Campos de formulario"/>
                        <ToggleButton x:Name="RailSignatures" Style="{StaticResource RailIconButton}" Content="&#xE8D7;" Click="RailButton_Click" ToolTip="Firmas digitales"/>
                        <ToggleButton x:Name="RailAttachments" Style="{StaticResource RailIconButton}" Content="&#xE723;" Click="RailButton_Click" ToolTip="Archivos adjuntos"/>
                        <ToggleButton x:Name="RailObjects" Style="{StaticResource RailIconButton}" Content="&#xE81E;" Click="RailButton_Click" ToolTip="Objetos de la página"/>
                    </StackPanel>
                </Border>

                <!-- Collapsible Left Side Panel -->
                <Border x:Name="SidePanelBorder" Grid.Column="1" BorderBrush="#22888888" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,10,8,8">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconToolbarButton}"
                                    Content="&#xE711;" Width="24" Height="24" FontSize="10"
                                    Click="BtnCollapseSidebar_Click"
                                    ToolTip="Ocultar panel"/>
                            <TextBlock x:Name="TxtSidePanelTitle" Text="Miniaturas" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <!-- Panel 0: Thumbnails (with Drag & Drop reordering) -->
                            <ListBox x:Name="PageList"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="PageList_PreviewMouseMove"
                                     Drop="PageList_Drop"
                                     SelectionChanged="PageList_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Insertar página en blanco" Click="BtnInsertBlankPage_Click"/>
                                        <MenuItem Header="Recortar página..." Click="BtnCropPage_Click"/>
                                        <MenuItem Header="Rotar 90° a la derecha" Click="BtnRotatePage_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Mover página arriba" Click="BtnMoveUp_Click"/>
                                        <MenuItem Header="Mover página abajo" Click="BtnMoveDown_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Extraer página..." Click="BtnExtractPage_Click"/>
                                        <MenuItem Header="Eliminar página" Click="BtnDeletePage_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,6" HorizontalAlignment="Center">
                                            <Border Background="White"
                                                    BorderBrush="#33888888"
                                                    BorderThickness="1"
                                                    Width="148"
                                                    MinHeight="168"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Panel 1: Collapsible Hierarchical Bookmarks TreeView + Add/Rename/Delete -->
                            <DockPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="8,2,8,8">
                                    <Button Style="{StaticResource SecondaryButton}" Content="+ Añadir" Padding="4,4" FontSize="11.5" Margin="0,0,3,0" Click="BtnAddBookmark_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Renombrar" Padding="4,4" FontSize="11.5" Margin="2,0,2,0" Click="BtnRenameBookmark_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Eliminar" Padding="4,4" FontSize="11.5" Margin="3,0,0,0" Click="BtnDeleteBookmark_Click"/>
                                </UniformGrid>
                                <TreeView x:Name="BookmarkTreeView"
                                          SelectedItemChanged="BookmarkTreeView_SelectedItemChanged"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Padding="4">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="2,3" FontSize="12.5"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </DockPanel>

                            <!-- Panel 2: Comments & Annotations -->
                            <DockPanel x:Name="CommentsPanel" Visibility="Collapsed">
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="8,2,8,8">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Editar nota" Padding="6,4" FontSize="11.5" Margin="0,0,3,0" Click="BtnEditAnnotation_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Eliminar" Padding="6,4" FontSize="11.5" Margin="3,0,0,0" Click="BtnDeleteAnnotation_Click"/>
                                </UniformGrid>
                                <ListBox x:Name="AnnotationList"
                                         SelectionChanged="AnnotationList_SelectionChanged"
                                         MouseDoubleClick="AnnotationList_MouseDoubleClick"
                                         KeyDown="AnnotationList_KeyDown"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6"
                                         ToolTip="Clic para ir a la página • Doble clic para editar comentario • Supr para eliminar">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,4">
                                                <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 3: Forms -->
                            <DockPanel x:Name="FormsPanel" Visibility="Collapsed">
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="8,2,8,8">
                                    <Button Style="{StaticResource SecondaryButton}" Content="+ Texto" Padding="6,4" FontSize="11.5" Margin="0,0,3,0" Click="BtnAddTextField_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="+ Casilla" Padding="6,4" FontSize="11.5" Margin="3,0,0,0" Click="BtnAddCheckboxField_Click"/>
                                </UniformGrid>
                                <ListBox x:Name="FormFieldList"
                                         MouseDoubleClick="FormFieldList_MouseDoubleClick"
                                         KeyDown="FormFieldList_KeyDown"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6"
                                         ToolTip="Clic en la página para rellenar directamente • Arrastra para mover • Supr para eliminar">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Value}" Opacity="0.75" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 4: Signatures -->
                            <DockPanel x:Name="SignaturesPanel" Visibility="Collapsed">
                                <Button DockPanel.Dock="Top"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Firmar documento..."
                                        Click="BtnSignPades_Click"
                                        Margin="10,2,10,8"/>
                                <ListBox x:Name="SignatureList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#33888888" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SignerName}" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding StatusSummary}" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" Opacity="0.85"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 5: Embedded File Attachments -->
                            <DockPanel x:Name="AttachmentsPanel" Visibility="Collapsed">
                                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="8,2,8,8">
                                    <Button Style="{StaticResource SecondaryButton}" Content="+ Adjuntar" Padding="4,4" FontSize="11.5" Margin="0,0,3,0" Click="BtnAddAttachment_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Guardar" Padding="4,4" FontSize="11.5" Margin="2,0,2,0" Click="BtnSaveAttachment_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Eliminar" Padding="4,4" FontSize="11.5" Margin="3,0,0,0" Click="BtnDeleteAttachment_Click"/>
                                </UniformGrid>
                                <ListBox x:Name="AttachmentList"
                                         MouseDoubleClick="AttachmentList_MouseDoubleClick"
                                         KeyDown="AttachmentList_KeyDown"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="6"
                                         ToolTip="Doble clic para extraer y guardar archivo • Supr para eliminar adjunto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeDisplay}" Opacity="0.7" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Panel 6: Page Objects -->
                            <ListBox x:Name="PageObjectList"
                                     Visibility="Collapsed"
                                     MouseDoubleClick="PageObjectList_MouseDoubleClick"
                                     KeyDown="PageObjectList_KeyDown"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="6"
                                     ToolTip="Doble clic en un texto para editarlo • Arrastra imágenes en la página • Supr para eliminar">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" Margin="4,4" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="SideSplitter" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- Center Viewport + Floating Search Overlay -->
                <Grid Grid.Column="3">
                    <viewport:PdfPageViewport x:Name="PdfViewport">
                        <viewport:PdfPageViewport.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copiar texto seleccionado" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                                <MenuItem Header="Resaltar selección" Click="MenuMarkupHighlight_Click"/>
                                <MenuItem Header="Subrayar selección" Click="MenuMarkupUnderline_Click"/>
                                <MenuItem Header="Tachar selección" Click="MenuMarkupStrikeOut_Click"/>
                                <Separator/>
                                <MenuItem Header="Buscar en el documento..." InputGestureText="Ctrl+F" Click="BtnToggleSearch_Click"/>
                                <MenuItem Header="Ajustar al ancho" Click="BtnFitWidth_Click"/>
                                <MenuItem Header="Ajustar a la página" Click="BtnFitPage_Click"/>
                                <MenuItem Header="Recortar página..." Click="BtnCropPage_Click"/>
                                <MenuItem Header="Rotar página 90°" Click="BtnRotatePage_Click"/>
                                <Separator/>
                                <MenuItem Header="Insertar imagen..." Click="BtnInsertImage_Click"/>
                            </ContextMenu>
                        </viewport:PdfPageViewport.ContextMenu>
                    </viewport:PdfPageViewport>

                    <!-- Floating Chrome/Edge-style Find Bar (Ctrl+F) -->
                    <Border x:Name="FloatingSearchBar"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,22,0"
                            Padding="10,6"
                            CornerRadius="6"
                            BorderBrush="#44888888"
                            BorderThickness="1"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.32" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearch"
                                     Width="200"
                                     Height="26"
                                     Padding="6,2"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtSearch_KeyDown"/>
                            <ToggleButton x:Name="BtnSearchMatchCase"
                                          Style="{StaticResource ToolToggleButton}"
                                          Content="Aa"
                                          FontFamily="Segoe UI"
                                          FontSize="11.5"
                                          FontWeight="SemiBold"
                                          Width="26" Height="26"
                                          Margin="4,0,0,0"
                                          Click="BtnSearchOption_Click"
                                          ToolTip="Coincidir mayúsculas y minúsculas"/>
                            <ToggleButton x:Name="BtnSearchWholeWord"
                                          Style="{StaticResource ToolToggleButton}"
                                          Content="ab|"
                                          FontFamily="Segoe UI"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Width="28" Height="26"
                                          Margin="2,0,0,0"
                                          Click="BtnSearchOption_Click"
                                          ToolTip="Solo palabras completas"/>
                            <TextBlock x:Name="TxtSearchStatus"
                                       Text=""
                                       MinWidth="56"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Opacity="0.75"
                                       Margin="6,0"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE70E;" Width="26" Height="26" FontSize="11" Click="BtnSearchPrev_Click" ToolTip="Coincidencia anterior (Shift+Enter)"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE70D;" Width="26" Height="26" FontSize="11" Click="BtnSearchNext_Click" ToolTip="Coincidencia siguiente (Enter)"/>
                            <Button Style="{StaticResource IconToolbarButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10" Click="BtnCloseSearch_Click" ToolTip="Cerrar (Esc)"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 5B. Welcome / Empty State Screen (visible when no document is open) -->
            <Grid x:Name="WelcomeContainer" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <Image Source="Assets/PDFVisor.png" Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="PDFVisor" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtWelcomeSubtitle"
                               Text="Abre un documento o arrastra archivos PDF aquí para empezar"
                               FontSize="13.5" Opacity="0.72" HorizontalAlignment="Center" Margin="0,6,0,22"/>

                    <Button x:Name="BtnWelcomeOpen"
                            Content="Abrir documento PDF"
                            Style="{StaticResource PrimaryAccentButton}"
                            HorizontalAlignment="Center"
                            Click="BtnOpen_Click"/>

                    <!-- Recent Documents Card -->
                    <StackPanel x:Name="RecentFilesSection" Margin="0,32,0,0" Visibility="Collapsed">
                        <DockPanel Margin="2,0,2,8">
                            <Button x:Name="BtnWelcomeClear"
                                    DockPanel.Dock="Right"
                                    Content="Limpiar"
                                    Click="BtnClearRecent_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Opacity="0.65"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <TextBlock x:Name="TxtWelcomeRecent" Text="Documentos recientes" FontSize="13" FontWeight="SemiBold" Opacity="0.85"/>
                        </DockPanel>
                        <Border BorderBrush="#28888888" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ListBox x:Name="RecentFilesList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="220"
                                     MouseDoubleClick="RecentFilesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5" Cursor="Hand">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13"/>
                                            <TextBlock Text="{Binding DirectoryDisplay}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Global Fluent Busy / Loading Overlay for Heavy Operations -->
    <Grid x:Name="BusyOverlay"
          Visibility="Collapsed"
          Background="#78000000"
          IsHitTestVisible="True">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="320"
                MaxWidth="440"
                Padding="26,22"
                CornerRadius="10"
                BorderBrush="#44888888"
                BorderThickness="1"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtBusyTitle"
                           Text="Procesando documento..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtBusyDetail"
                           Text=""
                           FontSize="12.5"
                           Opacity="0.72"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <ProgressBar x:Name="BusyProgressBar"
                             Height="5"
                             Margin="0,16,0,0"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True"
                             Foreground="#D92638"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
