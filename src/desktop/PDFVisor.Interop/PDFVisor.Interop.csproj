<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeEngineDir)PDFVisor.Engine.dll')">
    <Content Include="$(NativeEngineDir)PDFVisor.Engine.dll" Link="PDFVisor.Engine.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NativeEngineDir)pdfium.dll" Link="pdfium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NativeEngineDir)qpdf30.dll" Link="qpdf30.dll" Condition="Exists('$(NativeEngineDir)qpdf30.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
